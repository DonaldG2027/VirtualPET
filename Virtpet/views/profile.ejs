<%- include('partials/header') %>
<body>
    <p style="font-weight: bold; color: #333;">Hallo!!! Youse name shalt be <%= user %>! Let us maketh this pet!</p>
    <!-- pet creation form -->
    <% if (pet) { %>
        <!--display pet stats-->
        <p>You already made a pet, silly! Go play with <a href="/pet"><%= pet.name %></a>.</p>
    <% } else { %>
        <p>You do not have a pet yet. Please create one below.</p>
    <form id="createPet" action="/profile" method="POST" >
        Pet Name: <input type="text" name="petName" required></input><br>
        <!-- using html and css for colors-->
        Color: <input type="color" id="petColor" name="petColor" value="#ff0000"><br>
        <input type="submit" value="Create Pet">
    </form>
    <% } %>
    <p style="font-style: italic;">P.S</p>
    <br>
    <br>
    <a href="/">Back to Home</a>
    <img alt="Test Pet Image" style="width: 200px; height: auto; margin-top: 20px; filter: sepia(1) hue-rotate(100deg) saturate(2);" src="data:image/jpeg;base64,">
</body>
<%- include('partials/footer') %>