<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Way of Creation</title>
    <style>
      body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            background-color:  white;
        }

        .content-container {
            max-width: 600px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        p {
            margin: 10px 0;
            line-height: 1.5;
        }

        form {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            min-width: 300px;
        }

        form input[type="text"] {
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
            width: 200px;
            text-align: center;
        }

        form input[type="color"] {
            width: 60px;
            height: 40px;
            border: 2px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
        }

        form input[type="submit"] {
            padding: 12px 24px;
            background-color: black;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        form input[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        a {
            color: #667eea;
            text-decoration: none;
            font-weight: bold;
        }

        a:hover {
            text-decoration: underline;
        }

        .back-link {
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #ff6b6b;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .back-link:hover {
            background-color: #ff5252;
            color: white;
        }

        img {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            margin: 20px;
        }
        @media screen and (max-width: 768px) {
            body {
                padding: 15px;
            }
            
            form {
                padding: 20px;
                min-width: 250px;
            }
            
            form input[type="text"] {
                width: 180px;
            }
        }

        @media screen and (max-width: 480px) {
            body {
                padding: 10px;
            }
            
            .content-container {
                gap: 15px;
            }
            
            form {
                padding: 15px;
                min-width: 200px;
            }
            
            form input[type="text"] {
                width: 160px;
            }
        }
    </style>
</head>
<body>
    <p style="font-weight: bold; color: #333;">Hallo!!! Youse name shalt be <%= user %>! Let us maketh this pet!</p>
    <!-- money -->
    <div style="margin: 15px 0; padding: 10px; background-color: #f0f8ff; border-radius: 5px;">
        <h3>💰 Your Wallet</h3>
        <p><strong>Money: </strong><span id="userMoney"><%= userMoney || 0 %></span></p>
    </div>
    <!-- pet creation form -->
    <% if (pet) { %>
        <!--display pet stats-->
        <p style="font-family: 'Georgia', serif;">You already made a pet, silly! Go play with <a href="/pet"><%= pet.name %></a>.</p>
    <% } else { %>
        <p>You do not have a pet yet. Please create one below.</p>
    <form id="createPet" action="/profile" method="POST" >
        <label>Pet Name: </label>
        <input type="text" name="petName" required></input><br>
        <!-- using html and css for colors-->
        <label>Color: </label><input type="color" id="petColor" name="petColor" value="#ff0000"><br>
        <input type="submit" value="Create Pet">
    </form>
    <% } %>
    <p style="font-style: italic;">P.S. Want to refer a friend? Do so below:</p>
    <div style="margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px;">
        <h3>Refer your idiot friends!</h3>
        <p>Get 1 money for each of them that you refer!</p>
        <form action="/profile/referral" method="POST">
            <label for="friendEmail">Friend's Email:</label>
            <input type="email" id="friendEmail" name="friendEmail" required>
            <button type="submit">Send Referral (+1 Money)</button>
        </form>
    </div>
    <br>
    <br>
    <img alt="Pet maker Image" style="width: 200px; height: auto; margin-top: 20px; filter: sepia(1) hue-rotate(220deg) saturate(2);" src="data:image/jpeg;base64,">
    <a href="/">Back to Home</a>
<%- include('partials/footer') %>