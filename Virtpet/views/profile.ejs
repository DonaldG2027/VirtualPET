<%- include('partials/header') %>
<body>
    <p>Hallo!!! Youse name shalt be <%= user %>! Let us maketh this pet!</p>
    <!-- pet creation form -->
    <% if (pet) { %>
        <!--display pet stats-->
        <p>You already made a pet called <%= pet.name %>, silly! Go to <a href="/pet">your pet</a> instead, you goofball.</p>
        </div>
    <% } else { %>
    <form id="createPet" action="/profile" method="POST">
        Pet Name: <input type="text" name="petName" required></input><br>
        <!-- using html and css for colors-->
        Color: <input type="color" id="petColor" name="petColor" value="#ff0000"><br>
        <input type="submit" value="Create Pet">
    </form>
    <% } %>
    <br>
    <br>
    <a href="/">Back to Home</a>

</body>
<%- include('partials/footer') %>