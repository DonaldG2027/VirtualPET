<%- include('partials/header') %>
<body>
    <p>Hallo!!! Youse name shalt be <%= user %>! Let us maketh this pet!</p>
    <!-- pet creation form -->
    <% if (pet) { %>
        <!--display pet stats-->
        <div id="yourpetstats">
            <h1>Your Pet: <%= pet.name %></h1>
            <p>Type: <%= pet.type %></p>
            <p>Hunger: <%= pet.hunger %>/100</p>
            <p>Joy: <%= pet.joy %>/100</p>
            <p>Color: <span style="background-color: <%= pet.color %>; padding: 5px;"><%= pet.color %></span></p>

            <!-- interacting with the pet-->
            <button onclick="feedPet()">Feed your pet</button>
            <button onclick="playWithPet()">Play with your pet</button>
        </div>
    <% } else { %>
        <p>You do not have a pet yet. Please create one below.</p>
    <form id="createPet" action="/profile" method="POST" enctype="multipart/form-data">
        Pet Name: <input type="text" name="petName" required></input><br>
        Pet Type:<br>
        <input type="radio" id="dog" name="petType" value="dog" required>
        <label for="dog">Dog</label><br>
        <input type="radio" id="cat" name="petType" value="cat" required>
        <label for="cat">Cat</label><br>
        <input type="radio" id="bird" name="petType" value="bird" required>
        <label for="bird">Bird</label><br>
        Color <!-- using html and css-->
        <input type="color" id="petColor" name="petColor" value="#ff0000"><br>
        Upload Pet Image: <input type="file" name="petImage" accept="image/*" required><br>
        <input type="submit" value="Create Pet">
    </form>
    <% } %>
<br>

</body>
<script>   
    
    const alluploads = document.getElementById('alluploads');
    console.log(<%- JSON.stringify(uploads) %>);
    let ruploads = <%- JSON.stringify(uploads) %>;
    console.log(ruploads);
    console.log('First upload:', ruploads[0]);
    console.log('Upload properties:', Object.keys(ruploads[0]));
    ruploads.forEach(upload => {
        const filepathe = document.createElement('p');
        filepathe.textContent = upload.upload;
        alluploads.appendChild(filepathe);
    });
</script>
<%- include('partials/footer') %>