<%- include('partials/header') %>
<body>
<p style="border: 5px solid #000000; width: 600px; padding: 10px;">"HIIIIIIIII weary traveler may you peruse my wears HMMMMM?!?!"</p>
<img src="https://c8.alamy.com/comp/BM1FYK/18th-century-street-trader-selling-old-cloaks-suitscoatshats-and-swords-BM1FYK.jpg" alt="Tally Ho'" width="500" height="600">
<form id="storeForm" method="POST" action="/store">
<button type="button" id="buyer">
Buy
</button>
<button type="button" id="seller">
Sell
</button>
<button type="button" id="runner">
RUN!
</button>
<button type="submit" id="submitb" >
Submit
</button>
<input type="hidden" id="bresponse" name="buyresponse" value="">
<input type="hidden" id="sresponse" name="sellresponse" value="">
</form>
<script>
addEventListener('DOMContentLoaded', () => {
    document.getElementById('buyer').addEventListener('click', () => {
       let buyresponse=window.prompt('You chose to buy! Do you want item 1,2, or 3? price is same as number.(only type num no space)')
       alert('You chose to buy item ' + buyresponse);
       document.getElementById('bresponse').value = buyresponse;
    });
    document.getElementById('seller').addEventListener('click', () => {
        let sellresponse=window.prompt('You chose to sell! What item do you want to sell? type number for item 1,2,3 (only type num no space)')
        alert('You chose to sell item ' + sellresponse);
        document.getElementById('sresponse').value = sellresponse;
    });
    document.getElementById('runner').addEventListener('click', () => {
        alert('You ran away very quick...')
        window.location.href = '/';
    });
    document.getElementById('submitb').addEventListener('click', () => {   
    });
});
</script>
</body>

<%- include('partials/footer') %>