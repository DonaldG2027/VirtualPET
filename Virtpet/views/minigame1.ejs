<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Click Em' Dead Son!</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
            position:relative;
        }
        #clickButton {
            padding: 15px 30px;
            font-size: 24px;
            cursor: pointer;
            position:absolute;
            top:200px;
            right: 425px;
            color: rgb(255, 255, 255);
            background-color: black;
            box-shadow: 2px 2px 5px rgba(241, 5, 5, 0.712);
            border-radius: 1000px;
        }
        #bill {
            margin-top: 20px;
            width: 200px;
            height: auto;
            position: absolute;
            top: 500px;
            right: 320px;
        }
        #billText {
            font-size: 20px;
            margin-bottom: 20px;
            position: absolute;
            top: 400px;
            right: 140px;
            border-color: black;
            border-width: 2px;
            border-style: solid;
        }
    </style>
</head>
<body>
    <h1>Welcome to Click Em', <%= user %>!</h1>
    <button id="starter" style="font-size:24px;">Start Game</button>
    <button id="clickButton" style="font-size:24px;">◯</button>
    <p>Time Left: <span id="timeLeft">10</span> seconds</p>
    <p>Your Score: <span id="score">0</span></p>
    <p id="billText">Shoot the target as many times as you can in 10 seconds to earn points!</p>
    <img id="bill"src="data:image/jpeg;base64," alt="Bill cowboy" style="width:300px;height:200px;">
    <a href="/">Back to Home</a>
    <form id="submision" method="POST" action="/minigame1">
        <input type="hidden" id="fscore" name="finalScore">
    </form>
</body>
<script>    
    let score = 0;
    let timeLeft = 11; // seconds
    let timerInterval;

    const scoreDisplay = document.getElementById('score');
    const timeDisplay = document.getElementById('timeLeft');
    const target = document.getElementById('clickButton');
    const startButton = document.getElementById('starter');

    function startGame() {
        timerInterval = setInterval(() => {
            timeLeft--;
            timeDisplay.textContent = timeLeft;
            if (timeLeft <= 0) {
                endGame();
            }
        }, 1000);
    }

    function endGame() {
        clearInterval(timerInterval);
        alert(`Game Over! Your final score is: ${score}`);
        document.getElementById('fscore').value = score;
        let fsscore = document.getElementById('fscore').value;
        console.log("Final score set in hidden input:", fsscore);
        console.log("Submitting score:", score);
        document.forms[0].submit();
    }
    target.addEventListener('click', () => {
        if (timeLeft <= 0) return; // Ignore clicks if time is up
        if (timeLeft >= 11) return; // Ignore clicks before game starts
        score++;
        scoreDisplay.textContent = score;
    });
    startButton.addEventListener('click', () => {
        startButton.disabled = true;
        startGame();
    });
</script>
<%- include('partials/footer') %>