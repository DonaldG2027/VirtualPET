<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boilroom o' plates header partial</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        h1 {
            color: #ca7777;
        }
        #velcome {
            font-weight: bold;
            border: 5px dashed;
            color: #333;
            width: 550px;
        }
         #petHeader {
            color: #ca7777;
            font-weight: bold;
            text-decoration: underline;
        }
        #velcome {
            font-weight: bold;
            color: #333;
            width: 550px;
        }
        #petDisplay {
            border: 2px solid #ccc;
            padding: 15px;
            border-radius: 5px;
            width: 300px;
        }
    </style>
</head>
<body>
    <h1 id="petHeader">Your Virtual Pet</h1>
    <p id="velcome">Hey there, <%= user %>! What do you want to do with your pet today?</p>
    <br>
    <% if (pet) { %>
        <div id="petDisplay">
            <h2><%= pet.name %></h2>
            <p>Hunger: <%= pet.hunger %>/100</p>
            <p>Joy: <%= pet.joy %>/100</p>
            <p>Color: <span style="background-color: <%= pet.color %>; padding: 5px; color: white; border-radius: 3px;"><%= pet.color %></span></p>
            
            <!-- Pet interaction forms -->
            <div style="margin: 15px 0;">
                <form action="/pet/feed" method="POST" style="display: inline; margin-right: 10px;">
                    <button type="submit">Feed Pet</button>
                </form>
                
                <form action="/pet/play" method="POST" style="display: inline;">
                    <button type="submit">Play with Pet</button>
                </form>
            </div>
            
            <!-- NEW: Color change form -->
            <div style="margin: 15px 0; padding: 10px; border: 1px solid #ccc; border-radius: 5px;">
                <h3>Customize Your Pet</h3>
                <form action="/pet/color" method="POST" style="display: inline;">
                    <label for="newColor">Change Color: </label>
                    <input type="color" id="newColor" name="newColor" value="<%= pet.color %>">
                    <button type="submit">Update Color</button>
                </form>
            </div>

            <!-- abandoning pet option-->
            <div style="margin: 15px 0;">
                <form action="/pet/abandon" method="POST" style="display: inline;">
                    <button type="submit" style="background-color: red; color: white;">Abandon Pet</button>
                </form>
            
        </div>
    <% } else { %>
        <p>You don't even have a pet yet, you idiot! Go create one in your <a href="/profile">profile.</p>
        <a href="/profile">Create it here</a>
    <% } %>
    <br>
    <br>
    <a href="/">Back to Home</a>
</body>
<script> 
</script>
<%- include('partials/footer') %>