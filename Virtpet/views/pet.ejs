<%- include('partials/header') %>
<body>
    <h1>Your Virtual Pet</h1>
    <p>Hey there, <%= user %>! What do you want to do with your pet today?</p>
    <br>
    <% if (pet) { %>
        <div id="yourpetstats">
            <h1>Your Pet: <%= pet.name %></h1>
            <p>Hunger: <%= pet.hunger %>/100</p>
            <p>Joy: <%= pet.joy %>/100</p>
            <p>Color: <span style="background-color: <%= pet.color %>; padding: 5px;"><%= pet.color %></span></p>

            <!-- Use forms instead of onclick functions -->
            <form action="/pet/feed" method="POST" style="display: inline;">
                <button type="submit">Feed your pet</button>
            </form>
            <form action="/pet/play" method="POST" style="display: inline;">
                <button type="submit">Play with your pet</button>
            </form>
        </div>
    <% } else { %>
        <p>You don't even have a pet yet, you idiot! Go create one in <a href="/profile">your profile</a>.</p>
        <a href="/profile">Create it here</a>
    <% } %>
    <br><br>
    <a href="/">Back to Home</a>
</body>
<script>   
    // feed pet function placeholder
    function feedPet() {
        fetch('/pet/feed', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // update display
                alert('Your pet has been fed!');
                location.reload();
            } else {
                alert('Error feeding pet.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error feeding pet.');
        });
    }
    // play with pet function placeholder
    function playWithPet() {
        fetch('/pet/play', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('You played with your pet!');
                location.reload();
            } else {
                alert('Error playing with pet.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error playing with pet.');
        });
    }
</script>
<%- include('partials/footer') %>