<%- include('partials/header') %>
<body>
    <p style="color: #e28d1e; border: 5px solid #e28d1e; width:200px;">hallo!!!, <%= user %>!</p>
    <a href="/">Back to Home</a>
    <h2 style="color: #86837e;">Socket Test</h2>
    <div id="messages" style="color: #bb2424;"></div>
    <form id="messageForm">
        <input type="text" id="messageInput" autocomplete="off" placeholder="Type your message here..." />
        <button type="submit">Send</button>
    </form>
</body>
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const form = document.getElementById('messageForm');
    const input = document.getElementById('messageInput');
    const messagesDiv = document.getElementById('messages');
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (input.value) {
            socket.emit('update', input.value);
            input.value = '';
        }
    });
    socket.on('update', function(msg) {
        const msgElem = document.createElement('div');
        msgElem.textContent = msg+ <%- " (' said " + user + ".')" %>;
        messagesDiv.appendChild(msgElem);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    });
</script>
<%- include('partials/footer') %>