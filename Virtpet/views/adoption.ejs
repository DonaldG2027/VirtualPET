<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adoption</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        #velcome {
            color: #e28d1e;
        }
        #showp {
            font-size: 1.2em;
            margin-bottom: 15px;
            color:rgb(129, 202, 56);
        }
        #apology {
            color: #e74c3c;
            font-weight: bold;
        }
        #back-to-map {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            background-color: #3498db;
            color: white;
            text-decoration: none;
        }
        #back-to-map:hover {
            background-color: #2980b9;
        }
    </style>
</head>
<body>
    <h1 id="velcome">Hey there, <%= user %>! Wanna adopt a pet?</h1>

    <% if (pets && pets.length > 0) { %>
        <p id="showp">Here are some pets available for adoption(Don't try to adpot pets if you already have one will send new pet to void):</p>
        <ul>
            <% pets.forEach(function(pet) { %>
                <div style="border: 1px solid #ccc; margin: 10px; padding: 10px;">
                    <!--pet name, stats, color, adopt button-->
                    <h2><%= pet.name %></h2>
                    <p>Hunger: <%= pet.hunger %>/100</p>
                    <p>Joy: <%= pet.joy %>/100</p>
                    <p>Color: <span style="background-color: <%= pet.color %>; padding: 5px; color: white; border-radius: 3px;"><%= pet.color %></span></p>
                    <form action="/adoption/<%= pet.apid %>/adopt" method="POST">
                        <button type="submit">Adopt <%= pet.name %></button>
                    </form>
                </div>
            <% }); %>
        </ul>
    <% } else { %>
        <p id="apology">Sorry, there are no pets available for adoption right now. Check back later!</p>
    <% } %>
    <a id="back-to-map" href="/">Back to Map</a>
</body>
</html>